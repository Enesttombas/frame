{
  "manifest_version": 3,
  "name": "Frame — Kişisel Video Öğrenme",
  "version": "0.1.5",
  "description": "Frame masaüstü uygulaması açıkken YouTube üzerinde cümle tekrarı ve bağlamlı kelime kartları.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8767/*"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1:11434/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Frame uygulamasını aç"
  },
  "options_page": "settings.html",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["captions.js", "youtube-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "captions.js",
        "preferences.js",
        "player-panel.js",
        "youtube.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": ""
}
